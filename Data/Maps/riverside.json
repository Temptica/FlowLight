  "levels": [
    {"junction": 12, "title": "Kerkplein", "intro": "Four streets meet at the church and nobody knows who goes first. Pick a main road with priority signs and make the side streets yield.", "unlocks": ["Signs", "Crossings", "LaneArrows"], "demand": {"startPerMinute": 10, "peakPerMinute": 20, "rampMinutes": 3, "waveMinutes": 3}},
    {"junction": 11, "title": "Markt", "intro": "Traffic from Kerkplein now runs into the market square. Turning cars block everyone: give them their own lane.", "unlocks": ["TurnLanes"], "demand": {"startPerMinute": 12, "peakPerMinute": 24, "rampMinutes": 3, "waveMinutes": 3}},
    {"junction": 13, "title": "Oostkruis", "intro": "The ring road pours in from the east and Oostring can't find a gap. Few people walk out here. Try a traffic light, and give left turners their own lane so they don't block everyone behind them. Lights cost a little every minute to run, so only use them where signs can't cope.", "unlocks": ["TrafficLight"], "demand": {"startPerMinute": 13, "peakPerMinute": 26, "rampMinutes": 3, "waveMinutes": 3, "pedestriansPerMinute": 1}},
    {"junction": 16, "title": "Stationsplein", "intro": "Narrow station streets. Calm or redirect traffic with speed limits and one-way streets.", "unlocks": ["SpeedLimit", "OneWay"], "demand": {"startPerMinute": 20, "peakPerMinute": 40, "rampMinutes": 3, "waveMinutes": 3}},
    {"junction": 10, "title": "Westpoort", "intro": "Westlaan brings fast traffic off the ring. Lights can now give every direction its own green: select a light and pick which turns go in each phase. A dispatch clears crashes much faster.", "unlocks": ["TurnPhases", "Dispatch"], "demand": {"startPerMinute": 16, "peakPerMinute": 32, "rampMinutes": 3, "waveMinutes": 3}},
    {"junction": 15, "title": "Molenhoek", "intro": "Lights that react to waiting cars need detectors in the road.", "unlocks": ["Detectors", "SmartLight"], "demand": {"startPerMinute": 23, "peakPerMinute": 46, "rampMinutes": 3, "waveMinutes": 3}},
    {"junction": 17, "title": "Bloemenhoek", "intro": "Busy roads from every side. Turn lanes are the key here. Cameras keep red-light runners in line, and the fines pay for themselves.", "unlocks": ["Camera"], "demand": {"startPerMinute": 26, "peakPerMinute": 52, "rampMinutes": 3, "waveMinutes": 3}},
